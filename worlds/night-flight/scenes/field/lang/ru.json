{"strings": [
  {"text":"The Board of the Line","translation":"Правление линии","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"Директору Южной линии","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"О приостановке","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"ночных полётов","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"Ввиду потерь","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"прошлой зимы правление","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"просит директора рассмотреть,","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"не следует ли прекратить","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"ночные рейсы","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"до весны.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"СРОЧНО","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"ПРИКАЗ","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"Механик Робле увольняется","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"со службы на линии","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"за упущение при осмотре","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"мотора.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"Директор:","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"Поле у ангара","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"Половина одиннадцатого. Кепка в руках, ящик с инструментом уже собран.","where":"worlds/night-flight/scenes/field/scene.json caption"}

{"strings": [
  {"text":"The Board of the Line","translation":"노선 이사회","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"남부 노선 지배인 귀하","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"야간 비행","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"중단의 건","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"지난겨울의 손실을","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"감안하여, 이사회는","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"지배인에게 봄까지","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"야간 운항을 중단해야","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"하지 않을지 검토해 줄 것을","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"요청함.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"긴급","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"지령","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"정비사 로블레를","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"엔진 점검상의 과실로","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"노선 근무에서","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"해고함.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"지배인:","where":"worlds/night-flight/scenes/field/elements/paper.js"},

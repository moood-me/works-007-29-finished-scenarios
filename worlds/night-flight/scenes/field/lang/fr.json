{"strings": [
  {"text":"The Board of the Line","translation":"Le conseil de la ligne","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"Au directeur de la ligne du Sud","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"Sur la suspension","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"des vols de nuit","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"Vu les pertes","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"de l’hiver dernier, le conseil","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"prie le directeur d’examiner","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"s’il ne convient pas de suspendre","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"le service de nuit","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"jusqu’au printemps.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"URGENT","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"ORDRE","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"Roblet, mécanicien, est renvoyé","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"du service de la ligne","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"pour une faute dans la révision","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"d’un moteur.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"Le directeur :","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"Le terrain près du hangar","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"Dix heures et demie. Sa casquette à la main, sa caisse à outils déjà prête.","where":"worlds/night-flight/scenes/field/scene.json caption"}

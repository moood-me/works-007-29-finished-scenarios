{"strings": [
  {"text":"The Board of the Line","translation":"Der Verwaltungsrat der Linie","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"An den Direktor der Südlinie","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"Zur Einstellung","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"der Nachtflüge","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"Angesichts der Verluste","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"des letzten Winters bittet","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"der Verwaltungsrat den","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"Direktor zu prüfen, ob der","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"Nachtdienst nicht bis zum","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"Frühjahr einzustellen ist.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"EILT","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"VERFÜGUNG","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"Der Mechaniker Roblet wird","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"wegen eines Versäumnisses","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"bei der Prüfung eines Motors","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"aus dem Dienst entlassen.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"Der Direktor:","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"Das Feld am Hangar","where":"worlds/night-flight/scenes/field/scene.json title"},

{"strings": [
  {"text":"The Board of the Line","translation":"航線董事會","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"致南方航線主任","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"關於暫停","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"夜間飛行","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"鑑於去年冬天","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"的損失，董事會","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"請主任考慮","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"夜間航班","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"是否應暫停","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"至明年春天。","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"急件","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"命令","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"技工羅布萊","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"因檢查引擎時","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"出現疏失，","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"解除其航線職務。","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"主任：","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"機庫旁的空地","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"十點半。帽子拿在手上，工具箱已經收好了。","where":"worlds/night-flight/scenes/field/scene.json caption"}
]}

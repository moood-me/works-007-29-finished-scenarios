{"strings": [
  {"text":"The Board of the Line","translation":"El Consejo de la Línea","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"Al Director de la Línea Sur","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"Sobre la suspensión","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"de los vuelos nocturnos","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"En vista de las pérdidas","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"del invierno pasado, el Consejo","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"ruega al Director que considere","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"si no convendría suspender","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"el servicio nocturno","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"hasta la primavera.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"URGENTE","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"ORDEN","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"Roblet, mecánico, queda despedido","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"del servicio de la línea","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"por una falta en la revisión","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"de un motor.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"El Director:","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"El campo junto al hangar","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"Las diez y media. La gorra en las manos, la caja de herramientas ya hecha.","where":"worlds/night-flight/scenes/field/scene.json caption"}
]}

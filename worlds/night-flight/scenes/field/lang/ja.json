{"strings": [
  {"text":"The Board of the Line","translation":"航空会社本社","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"南方路線支配人殿","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"夜間飛行の","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"停止について","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"昨冬の損失にかんがみ、","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"本社は支配人に対し、","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"夜間便を春まで","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"停止すべきか否か、","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"検討を","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"要請する。","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"至急","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"指令","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"整備士ロブレを","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"エンジン点検における","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"過失により","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"路線の職務から解雇する。","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"支配人","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"格納庫のそばの飛行場","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"午後十時半。帽子を手に、道具箱はもう片づけてある。","where":"worlds/night-flight/scenes/field/scene.json caption"}
]}

{"strings": [
  {"text":"The Board of the Line","translation":"Правління лінії","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"Директорові Південної лінії","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"Про призупинення","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"нічних польотів","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"Зважаючи на втрати","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"минулої зими, правління","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"просить директора розглянути,","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"чи не слід припинити","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"нічні рейси","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"до весни.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"ТЕРМІНОВО","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"НАКАЗ","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"Механіка Робле звільнено","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"зі служби на лінії","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"за недогляд під час огляду","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"мотора.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"Директор:","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"Поле біля ангара","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"Пів на одинадцяту. Кашкет у руках, скриньку з інструментом уже зібрано.","where":"worlds/night-flight/scenes/field/scene.json caption"}

  {"text":"for a fault in the inspection","translation":"за недагляд пры аглядзе","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"матора.","where":"worlds/night-flight/scenes/field/elements/paper.js"},

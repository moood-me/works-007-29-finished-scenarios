{"strings": [
  {"text":"The Board of the Line","translation":"O Conselho da Linha","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"To the Director of the Southern Line","translation":"Ao Diretor da Linha do Sul","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"On suspending","translation":"Sobre a suspensão","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"the night flights","translation":"dos voos noturnos","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"In view of the losses","translation":"Em vista das perdas","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"of last winter, the Board","translation":"do inverno passado, o Conselho","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"asks the Director to consider","translation":"pede ao Diretor que avalie","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"whether the night service","translation":"se o serviço noturno","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"should not be suspended","translation":"não deveria ser suspenso","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"until the spring.","translation":"até a primavera.","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"URGENT","translation":"URGENTE","where":"worlds/night-flight/scenes/field/elements/folder.js"},
  {"text":"ORDER","translation":"ORDEM","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"Roblet, mechanic, is dismissed","translation":"Roblet, mecânico, é demitido","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"from the service of the line","translation":"do serviço da linha","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"for a fault in the inspection","translation":"por uma falha na inspeção","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"of an engine.","translation":"de um motor.","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Director:","translation":"O Diretor:","where":"worlds/night-flight/scenes/field/elements/paper.js"},
  {"text":"The Field by the Hangar","translation":"O campo junto ao hangar","where":"worlds/night-flight/scenes/field/scene.json title"},
  {"text":"Half past ten. His cap in his hands, his tool box already packed.","translation":"Dez e meia. O boné nas mãos, a caixa de ferramentas já arrumada.","where":"worlds/night-flight/scenes/field/scene.json caption"}
]}

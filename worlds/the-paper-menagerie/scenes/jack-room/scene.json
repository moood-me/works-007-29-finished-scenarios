  "states": {
    "moment": {
      "values": [
        "bedtime",
        "night",
        "hatch",
        "ran",
        "call",
        "packed"
      ],
      "means": "which of the scenario's moments the room shows (notes.md has the table) — set at once, it sets the room's light, what stands where and who is here, by `menagerie` too: bedtime — the prologue's night (П.4), Mom sitting by Jack on his bed, Laohu by him; night — 1.6, Jack on his bed over the empty shoe box, the animals on the shelf, Laohu taped on the pillow; hatch — 1.6, the box shut on the stool under the open attic hatch in the hall, Jack under it; ran — 1.4 after running away, dusk: Jack at the window, the scraps on the sill, Dad at the shut door with the buns; call — 1.5 after running away, evening: Mom at the open door, Jack by the window with the scraps; packed — chapter 3 (3.2), the house sold: the room emptied, day, Jack grown"
    },
    "menagerie": {
      "values": [
        "shelf",
        "attic",
        "laohu",
        "house"
      ],
      "means": "the game's «Зверинец», as it leaves the room (with `moment` sets what is where): shelf — not chosen yet, the animals at home on the shelf; attic (0) — all of them put away in the shoe box; laohu (1) — the rest put away, Laohu kept (asleep on the pillow); house (2) — none put away, the whole house awake (goats on the quilt, the buffalo on the sill, cranes on the curtains, frogs on the desk). In `packed`: attic — the box down from the attic, open on the floor, the dusty animals and Laohu out of it; laohu, house — Laohu alone on the bare shelf (house: Dad in the doorway with a paper frog)"
    },
    "night": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "the light toward night: 0 the spring dusk (pink and blue at the window), 1 night (navy and stars, Mark's window and the street lamp lit) — the look `night`"
    },
    "day": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "the light toward a spring afternoon: 1 day, the sun coming in at the window across the floor, dust in its beam — the look `day`"
    },
    "lamp": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "Jack's bedside lamp: 0 out, 1 lit — the warm light on the bed and the shelf"
    },
    "hall": {
      "range": [
        0,
        1
      ],
      "smooth": true,
      "means": "the hall's bare bulb: 0 out, 1 lit — the light on whoever stands at the door and under the hatch"
    },
    "packed": {
      "type": "boolean",
      "means": "the house sold and packed (chapter 3): the bed stripped to its ticking, the pillow, rug, curtains, lamp and pictures gone (their pale patches on the walls), cartons on the bed and the floor"
    },
    "shelf": {
      "values": [
        "animals",
        "deer",
        "empty",
        "bare"
      ],
      "means": "what stands on the shelf: animals — the two goats, the deer, the buffalo, the books, the robot; deer — the goats and the buffalo out in the room, the deer left; empty — the animals put away, the books and the robot; bare — nothing (the room emptied). Its right end is Laohu's place when he is on the shelf (laohu_a −1.1, laohu_d 4.12, laohu_e 1.285)"
    },
    "zoo": {
      "type": "boolean",
      "means": "the whole house awake («Зверинец» 2): paper cranes perched on the curtains, the goats out (where goats_a/d/e put them), the buffalo in a flower pot on the sill, three frogs on the desk"
    },
    "scraps": {

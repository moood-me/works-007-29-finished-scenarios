{"strings": [
  {"text":"YE OTIS GHOSTE","translation":"ПРИВИД ОТІСІВ","where":"worlds/the-canterville-ghost/scenes/corridor/elements/spook.js"},
  {"text":"Ye Onlie True and Originale Spook.","translation":"Єдиний справжній і оригінальний.","where":"worlds/the-canterville-ghost/scenes/corridor/elements/spook.js"},
  {"text":"Beware of Ye Imitationes.","translation":"Стережися підробок.","where":"worlds/the-canterville-ghost/scenes/corridor/elements/spook.js"},
  {"text":"All others are Counterfeite.","translation":"Усі інші — фальшивка.","where":"worlds/the-canterville-ghost/scenes/corridor/elements/spook.js"},
  {"text":"The Corridor","translation":"Коридор","where":"worlds/the-canterville-ghost/scenes/corridor/scene.json title"},

{"strings": [
  {"text":"YE OTIS GHOSTE","translation":"O PHANTASMA DOS OTIS","where":"worlds/the-canterville-ghost/scenes/tapestry/elements/turnip.js"},
  {"text":"Ye Onlie True and Originale Spook.","translation":"O Único Verdadeiro e Original Espectro.","where":"worlds/the-canterville-ghost/scenes/tapestry/elements/turnip.js"},

{"strings": [
  {"text":"YE OTIS GHOSTE","translation":"ПРИВИД ОТІСІВ","where":"worlds/the-canterville-ghost/scenes/tapestry/elements/turnip.js"},
  {"text":"Ye Onlie True and Originale Spook.","translation":"Єдиний справжній і оригінальний.","where":"worlds/the-canterville-ghost/scenes/tapestry/elements/turnip.js"},
  {"text":"Beware of Ye Imitationes.","translation":"Стережися підробок.","where":"worlds/the-canterville-ghost/scenes/tapestry/elements/turnip.js"},
  {"text":"All others are Counterfeite.","translation":"Усі інші — фальшивка.","where":"worlds/the-canterville-ghost/scenes/tapestry/elements/turnip.js"},
  {"text":"The Tapestry Chamber","translation":"Гобеленова кімната","where":"worlds/the-canterville-ghost/scenes/tapestry/scene.json title"},
  {"text":"Autumn, late in the afternoon. The door of the Tapestry Chamber stands ajar.","translation":"Осінь, надвечір. Двері Гобеленової кімнати прочинені.","where":"worlds/the-canterville-ghost/scenes/tapestry/scene.json caption"}

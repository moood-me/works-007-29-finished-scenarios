{"strings": [
  {"text":"When a golden girl can win","translation":"Gdy złota dziewczyna z warg grzechu","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"Prayer from out the lips of sin,","translation":"Modlitwę wydobyć zdoła,","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"When the barren almond bears,","translation":"Gdy migdał bezpłodny zakwitnie,","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"And a little child gives away its tears,","translation":"A dziecię łzy swoje odda,","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"Then shall all the house be still","translation":"Wtedy dom cały ucichnie","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"And peace come to Canterville.","translation":"I pokój zstąpi na Canterville.","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"The Library","translation":"Biblioteka","where":"worlds/the-canterville-ghost/scenes/library/scene.json title"},
  {"text":"Canterville Chase, past midnight. The bloodstain by the fireplace is back again.","translation":"Canterville Chase, po północy. Plama krwi przy kominku znów jest na miejscu.","where":"worlds/the-canterville-ghost/scenes/library/scene.json caption"}

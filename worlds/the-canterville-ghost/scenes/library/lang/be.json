{"strings": [
  {"text":"When a golden girl can win","translation":"Калі дзяўчына залатая","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"Prayer from out the lips of sin,","translation":"Вырве з вуснаў граху малітву,","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"When the barren almond bears,","translation":"Калі бясплодны міндаль расквітнее,","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"And a little child gives away its tears,","translation":"І дзіця аддасць свае слёзы,","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"Then shall all the house be still","translation":"Тады ўвесь дом сціхне","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"And peace come to Canterville.","translation":"І мір прыйдзе ў Кентэрвіль.","where":"worlds/the-canterville-ghost/scenes/library/elements/window.js"},
  {"text":"The Library","translation":"Бібліятэка","where":"worlds/the-canterville-ghost/scenes/library/scene.json title"},
  {"text":"Canterville Chase, past midnight. The bloodstain by the fireplace is back again.","translation":"Кентэрвільскі замак, за поўнач. Крывавая пляма ля каміна зноў на месцы.","where":"worlds/the-canterville-ghost/scenes/library/scene.json caption"}
]}

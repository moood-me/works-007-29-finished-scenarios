      "means": "the sheep in the dry-stone pen (the prologue and the first chapter)"
    },
    "hives": {
      "type": "boolean",
      "means": "Elzéard's five hives along the front of the old pen (from the second chapter: «ульи вместо овец»)"
    },
    "dog": {
      "type": "boolean",
      "means": "the shepherd's dog lying by the door"
    },
    "rod_ground": {
      "type": "boolean",
      "means": "the iron rod stuck in the ground by the path (when it is not in Elzéard's hand)"
    },
    "bread_step": {
      "type": "boolean",
      "means": "a loaf and a pair of knitted socks on the doorstep, untouched (3.4 when Lina knows; the epilogue on Silence)"
    },
    "door": {
      "values": [
        "open",
        "propped"
      ],
      "means": "the door: open (the room behind it lit by the lamp, or dark); propped — shut from outside and propped with a stick (3.5 on the Name: the Traveller shuts the empty house)"
    },
    "trodden": {
      "type": "boolean",
      "means": "the path to the door trodden wide and bare by the people who come to look (3.5 on the Name)"
    },
    "porch_saplings": {
      "type": "boolean",
      "means": "seedlings just planted by the door (the epilogue on Silence: old, he plants at his own porch)"
    },
    "hut": {
      "type": "boolean",
      "means": "the hut beyond the ridge in place of the house (the epilogue on the Name): a low stone hut, the slope behind it waist-high with his last ten years' growth, a new edge of seedlings before it on the bare ground; the house, the pen and the lantern gone"
    },
    "moment": {
      "values": [
        "arrival",
        "leaving",
        "night",
        "evening",
        "ranger",
        "empty",
        "last_silence",
        "hut"
      ],
      "means": "which moment of the scenario the house shows (script.js lays it out; notes.md): arrival — П.3, dusk, the Traveller come up; leaving — 1.6, dawn, the Traveller going; night — 2.7, six years on, night, the hives; evening — 3.4, fourteen years on; ranger — 3.5 on the Name, the morning the ranger comes; empty — 3.5 on the Name, later: the house empty, strangers at the door; last_silence — the epilogue on Silence; hut — the epilogue on the Name: the hut beyond the ridge"
    },
    "staged": {
      "values": [
        "arrival",
        "leaving",
        "night",
